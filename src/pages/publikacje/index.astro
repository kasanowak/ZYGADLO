---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import MoreButton from '../../components/MoreButton.astro';
import { getPosts } from '../../lib/content';
import { publicationCategories } from '../../data/site';

const PAGE = 18;
const publikacje = (await getPosts('publikacje')).map((p) => ({
  title: p.data.title,
  source: p.data.zrodlo,
  href: `/publikacje/${p.id}`,
  cat: p.data.kategoria,
  date: p.data.data,
}));
const wywiady = (await getPosts('wywiady')).map((p) => ({
  title: p.data.title,
  source: p.data.zrodlo,
  href: `/wywiady/${p.id}`,
  cat: 'wywiady',
  date: p.data.data,
}));
const items = [...publikacje, ...wywiady].sort((a, b) => b.date.getTime() - a.date.getTime());
/** Tytuły ujmujemy w cudzysłów, jeśli autor go nie wpisał. */
const quote = (t: string) => (/^[„“"]/.test(t) ? t : `„${t}”`);
---
<Base title="Publikacje" description="Publikacje artystyczne i naukowe Andrzeja Żygadły.">
  <PageHead title="Publikacje" filters={[...publicationCategories]} />
  <section class="list-wrap" data-listing data-page-size={PAGE}>
    <ul class="pubs">
      {
        items.map((p, i) => (
          <li data-item data-cat={p.cat} hidden={i >= PAGE}>
            <a href={p.href} class="pub">
              <span class="pub__title">{quote(p.title)}</span>
              {p.source && <span class="pub__source caption">{p.source}</span>}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="empty-state" data-empty hidden>Brak publikacji w tej kategorii.</p>
    {items.length > PAGE && <MoreButton />}
  </section>
</Base>
<script>
  import '../../scripts/listing';
</script>

<style>
  .pubs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(32px, 4.2vw, 80px);
    row-gap: clamp(48px, 5.3vw, 102px);
    max-width: 1570px;
  }
  .pubs li[hidden] {
    display: none;
  }
  .pub {
    display: block;
    max-width: 480px;
  }
  .pub__title {
    display: block;
    font-style: italic;
    font-size: var(--fs-body);
    line-height: 1.79;
    letter-spacing: 0.05em;
    transition: color 0.25s ease;
  }
  .pub__source {
    display: block;
    max-width: 340px;
    margin-top: 0.9em;
    font-size: 12px;
  }
  .pub:hover .pub__title {
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .pubs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 899px) {
    .pubs {
      grid-template-columns: 1fr;
      row-gap: 0;
    }
    .pubs li {
      border-bottom: 1px solid var(--line);
    }
    .pub {
      padding: 24px 0;
      max-width: none;
    }
    .pub__title {
      font-size: 16px;
    }
    .pub__source {
      font-size: 14px;
      max-width: none;
    }
  }
</style>
