---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Sekcje from '../components/Sekcje.astro';

// Treść edytowana w CMS: src/content/strony/bio.md
const bio = await getEntry('strony', 'bio');
if (!bio) throw new Error('Brak pliku src/content/strony/bio.md');
const { Content } = await render(bio);
const d = bio.data;
---
<Base title={d.title} description={d.opis}>
  <PageHead title={d.title} />
  <article class="article bio">
    {d.wstep && <p class="lead bio__lead">{d.wstep}</p>}

    {
      d.zdjecie && (
        <figure class="bio__photo">
          <Image src={d.zdjecie} alt={d.zdjecieAlt} widths={[400, 700, 960]} sizes="(min-width: 900px) min(900px, 47vw), calc(100vw - 52px)" loading="eager" />
        </figure>
      )
    }

    <div class="prose bio__text">
      <Content />
    </div>

    <Sekcje sekcje={d.sekcje} />
  </article>
</Base>

<style>
  .bio {
    padding-top: clamp(16px, 3vw, 60px);
    padding-bottom: clamp(64px, 6.9vw, 133px);
  }
  .bio__lead {
    margin-top: calc(var(--fs-display) * -0.15);
  }
  .bio__photo {
    margin: clamp(28px, 4.2vw, 80px) 0 clamp(28px, 4.1vw, 78px);
    max-width: min(900px, 100%) !important;
  }
  .bio__photo :global(img) {
    width: 100%;
  }
  .bio__text {
    color: var(--ink);
  }
  .bio :global(.lista:first-of-type) {
    margin-top: clamp(32px, 2.6vw, 50px);
  }
  @media (max-width: 899px) {
    .bio__lead {
      margin-top: 24px;
    }
  }
</style>
