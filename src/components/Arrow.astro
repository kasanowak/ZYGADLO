  class:list={['arrow', cls]}
  width="26"
  height="14"
  viewBox="5 5 27 14.5"
  fill="none"
  aria-hidden="true"
  focusable="false"
  style={rotate ? `transform: rotate(${rotate}deg)` : undefined}
